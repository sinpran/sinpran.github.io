---
import { getCollection, render } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const entries = await getCollection("work", ({ data }) => !data.draft);
  const sorted = entries.sort((a, b) => a.data.order - b.data.order);

  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sorted[i - 1], next: sorted[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

const icons = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/icons/*.png",
  { eager: true },
);
const icon = entry.data.icon
  ? icons[`../../assets/icons/${entry.data.icon}`]?.default
  : undefined;
---

<Base
  title={entry.data.title}
  description={entry.data.tagline}
  ogTitle={`${entry.data.title} — ${entry.data.tagline}`}
>
  <main id="main" class="mx-auto max-w-2xl px-6 pb-24">
    <nav class="pt-12" aria-label="Breadcrumb">
      <a href="/#projects" class="text-ink-muted hover:text-accent text-[0.875rem] transition-colors">
        ← Back
      </a>
    </nav>

    <header class="mt-10 text-center">
      {
        icon && (
          <Image
            src={icon}
            alt=""
            width={128}
            height={128}
            loading="eager"
            class="app-icon mx-auto size-16"
          />
        )
      }
      <h1 class="text-title mt-5">{entry.data.title}</h1>
      <p class="text-ink-secondary mx-auto mt-2 max-w-[40ch] text-[0.9375rem] leading-relaxed">
        {entry.data.tagline}
      </p>
      <p class="text-ink-muted mt-3 text-[0.8125rem]">
        {entry.data.year} · {entry.data.platform}
      </p>
    </header>

    <p
      class="border-hairline text-ink mx-auto mt-10 max-w-[44ch] border-t border-b py-6 text-center text-[1.0625rem] leading-relaxed text-balance"
    >
      {entry.data.constraint}
    </p>

    <div class="prose-simple mt-10">
      <Content />
    </div>

    <section class="mt-14">
      <h2 class="text-ink-muted mb-5 font-sans text-[0.8125rem] font-medium tracking-[0.14em] uppercase">
        Spec
      </h2>
      <dl class="space-y-4">
        {
          entry.data.spec.map((item) => (
            <div class="sm:flex sm:gap-6">
              <dt class="text-ink-muted text-[0.875rem] sm:w-32 sm:shrink-0">{item.label}</dt>
              <dd class="text-ink-secondary text-[0.9375rem] leading-relaxed">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <nav
      class="border-hairline mt-14 flex flex-col gap-4 border-t pt-8 sm:flex-row sm:justify-between"
      aria-label="More projects"
    >
      {
        prev ? (
          <a href={`/work/${prev.id}/`} class="text-ink-muted hover:text-accent text-[0.875rem] transition-colors">
            ← {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a
            href={`/work/${next.id}/`}
            class="text-ink-muted hover:text-accent text-[0.875rem] transition-colors sm:text-right"
          >
            {next.data.title} →
          </a>
        )
      }
    </nav>
  </main>
</Base>
