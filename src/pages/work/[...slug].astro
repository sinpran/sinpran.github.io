---
import { getCollection, render } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const entries = await getCollection("work", ({ data }) => !data.draft);
  const sorted = entries.sort((a, b) => a.data.order - b.data.order);

  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: sorted[i - 1],
      next: sorted[i + 1],
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

const icons = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/icons/*.png",
  { eager: true },
);
const icon = entry.data.icon
  ? icons[`../../assets/icons/${entry.data.icon}`]?.default
  : undefined;

const num = String(entry.data.order).padStart(2, "0");
---

<Base
  title={entry.data.title}
  description={entry.data.tagline}
  ogTitle={`${entry.data.title} — ${entry.data.tagline}`}
>
  <main id="main" class="mx-auto max-w-4xl px-6 pb-28 sm:px-8">
    <nav class="pt-12 sm:pt-16" aria-label="Breadcrumb">
      <a
        href="/#work"
        class="font-mono text-meta text-ink-muted transition-colors hover:text-accent"
      >
        ← Selected work
      </a>
    </nav>

    <header class="mt-12 border-b border-hairline pb-12">
      <div class="flex items-start gap-6">
        {
          icon && (
            <Image
              src={icon}
              alt={`${entry.data.title} app icon`}
              width={96}
              height={96}
              loading="eager"
              class="app-icon size-20 shrink-0 sm:size-24"
            />
          )
        }
        <div class="min-w-0">
          <p class="font-mono text-meta tracking-[0.18em] text-ink-muted uppercase">
            {num} · {entry.data.year} · {entry.data.platform}
          </p>
          <h1 class="text-heading mt-3">{entry.data.title}</h1>
          <p class="mt-3 max-w-[46ch] text-[0.9375rem] leading-relaxed text-ink-secondary">
            {entry.data.tagline}
          </p>
        </div>
      </div>

      <blockquote
        class="text-accent mt-12 max-w-[38ch] border-l-2 border-accent pl-5 font-display text-[clamp(1.35rem,2.8vw,1.9rem)] leading-[1.3] tracking-[-0.015em]"
      >
        {entry.data.constraint}
      </blockquote>
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_16rem] lg:gap-14">
      <div class="prose-editorial order-2 lg:order-1">
        <Content />
      </div>

      <aside class="order-1 lg:order-2">
        <h2
          class="font-mono text-meta tracking-[0.18em] text-ink-muted uppercase border-b border-hairline pb-3"
        >
          Spec
        </h2>
        <dl class="mt-4 space-y-4">
          {
            entry.data.spec.map((item) => (
              <div>
                <dt class="font-mono text-[0.6875rem] tracking-[0.12em] text-ink-muted uppercase">
                  {item.label}
                </dt>
                <dd class="mt-1 text-[0.875rem] leading-relaxed text-ink-secondary">
                  {item.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>

    <nav
      class="mt-24 flex flex-col gap-4 border-t border-hairline pt-8 sm:flex-row sm:justify-between"
      aria-label="More work"
    >
      {
        prev ? (
          <a
            href={`/work/${prev.id}/`}
            class="group font-mono text-meta text-ink-muted transition-colors hover:text-accent"
          >
            <span class="block text-[0.6875rem] tracking-[0.12em] uppercase">Previous</span>
            <span class="mt-1 block text-ink-secondary group-hover:text-accent">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a
            href={`/work/${next.id}/`}
            class="group font-mono text-meta text-ink-muted transition-colors hover:text-accent sm:text-right"
          >
            <span class="block text-[0.6875rem] tracking-[0.12em] uppercase">Next</span>
            <span class="mt-1 block text-ink-secondary group-hover:text-accent">
              {next.data.title}
            </span>
          </a>
        )
      }
    </nav>
  </main>
</Base>
