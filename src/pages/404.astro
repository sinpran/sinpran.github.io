---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="That page does not exist.">
  <main
    id="main"
    class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center px-6 pb-24 text-center"
  >
    <h1 class="text-title">This page does not exist.</h1>
    <p class="text-ink-secondary mx-auto mt-3 max-w-[40ch] text-[0.9375rem] leading-relaxed">
      The link may be out of date, or the page may have moved.
    </p>
    <p class="mt-7">
      <a href="/" class="link-underline text-[0.9375rem]">Back to the homepage</a>
    </p>
  </main>
</Base>
