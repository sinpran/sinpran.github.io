---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Row from "../components/Row.astro";
import { site } from "../data/site";

const icons = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/icons/*.png",
  { eager: true },
);
const iconFor = (name?: string) =>
  name ? icons[`../assets/icons/${name}`]?.default : undefined;

const work = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const contactLinks = [
  { label: "Email", href: `mailto:${site.email}` },
  { label: "GitHub", href: site.links.github },
  { label: "LinkedIn", href: site.links.linkedin },
  { label: "Résumé", href: site.links.resume },
];
---

<Base>
  <main id="main" class="mx-auto max-w-4xl px-6 pb-28 sm:px-8">
    <header class="pt-20 sm:pt-32">
      <p
        class="rise font-mono text-meta tracking-[0.22em] text-ink-muted uppercase"
        style="--stagger-index: 0"
      >
        {site.name}
      </p>

      <h1
        class="rise text-display mt-8 max-w-[20ch] text-balance"
        style="--stagger-index: 1"
      >
        {site.hero.statement}
      </h1>

      <p
        class="rise mt-8 max-w-[52ch] font-mono text-meta leading-relaxed text-ink-secondary"
        style="--stagger-index: 2"
      >
        {site.hero.subline}
      </p>

      <div
        class="rise mt-10 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-meta text-ink-muted"
        style="--stagger-index: 3"
      >
        <span class="status-dot" aria-hidden="true"></span>
        <span>{site.hero.status}</span>
        <span aria-hidden="true">·</span>
        <span>{site.location}</span>
      </div>

      <nav
        class="rise mt-8 flex flex-wrap gap-x-6 gap-y-2"
        style="--stagger-index: 4"
        aria-label="Contact"
      >
        {
          contactLinks.map((link) => (
            <a
              href={link.href}
              class="text-accent decoration-accent/40 hover:decoration-accent text-[0.9375rem] underline underline-offset-4 transition-colors"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>

    <Section id="about" label="About">
      <div class="prose-editorial">
        {site.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </Section>

    <Section id="experience" label="Experience">
      <ol>
        {
          site.experience.map((role, i) => (
            <Row
              index={i + 1}
              title={role.company}
              subtitle={role.title}
              meta={role.period}
              metaSecondary={role.location}
            >
              <ul class="mt-4 space-y-2">
                {role.bullets.map((bullet) => (
                  <li class="relative pl-5 text-[0.9375rem] leading-relaxed text-ink-secondary">
                    <span
                      class="bg-hairline-strong absolute top-[0.72em] left-0 h-px w-2.5"
                      aria-hidden="true"
                    />
                    {bullet}
                  </li>
                ))}
              </ul>
            </Row>
          ))
        }
      </ol>

      <div class="mt-10 grid gap-x-8 gap-y-4 sm:grid-cols-2">
        {
          site.education.map((entry) => (
            <div class="border-t border-hairline pt-4">
              <p class="text-[0.9375rem]">{entry.school}</p>
              <p class="mt-1 font-mono text-meta text-ink-muted">{entry.detail}</p>
            </div>
          ))
        }
      </div>
    </Section>

    <Section id="work" label="Selected work" note="Personal projects">
      <p class="prose-editorial mb-10 text-[0.9375rem] leading-relaxed text-ink-secondary">
        Three iOS apps that share a shape: local-first, no backend, no account, and
        a language model that is only ever allowed to interpret numbers the app
        computed itself. Source is private, so these are write-ups rather than
        links.
      </p>

      <ol>
        {
          work.map((entry) => (
            <Row
              index={entry.data.order}
              title={entry.data.title}
              subtitle={entry.data.tagline}
              meta={entry.data.year}
              metaSecondary={entry.data.platform}
              href={`/work/${entry.id}/`}
              icon={iconFor(entry.data.icon)}
              iconAlt={`${entry.data.title} app icon`}
            />
          ))
        }
      </ol>
    </Section>

    {
      posts.length > 0 && (
        <Section id="writing" label="Writing">
          <ol>
            {posts.map((post, i) => (
              <Row
                index={i + 1}
                title={post.data.title}
                subtitle={post.data.description}
                meta={post.data.date.toLocaleDateString("en-US", {
                  month: "short",
                  year: "numeric",
                })}
                href={`/writing/${post.id}/`}
              />
            ))}
          </ol>
        </Section>
      )
    }

    <Section id="skills" label="Toolkit">
      <dl class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
        {
          site.skills.map((group) => (
            <div class="border-t border-hairline pt-4">
              <dt class="font-mono text-meta tracking-wider text-ink-muted uppercase">
                {group.label}
              </dt>
              <dd class="mt-2 text-[0.9375rem] text-ink-secondary">{group.items}</dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <footer
      class="mt-24 flex flex-col gap-6 border-t border-hairline pt-8 sm:mt-32 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="font-mono text-meta text-ink-muted">
        {site.name} · {site.location}
      </p>
      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
        {
          contactLinks.map((link) => (
            <a
              href={link.href}
              class="font-mono text-meta text-ink-muted transition-colors hover:text-accent"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </footer>
  </main>
</Base>
