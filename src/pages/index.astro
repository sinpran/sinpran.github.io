---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Avatar from "../components/Avatar.astro";
import { site } from "../data/site";

const icons = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/icons/*.png",
  { eager: true },
);
const iconFor = (name?: string) =>
  name ? icons[`../assets/icons/${name}`]?.default : undefined;

const work = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const contactLinks = [
  { label: "Email", href: `mailto:${site.email}` },
  { label: "GitHub", href: site.links.github },
  { label: "LinkedIn", href: site.links.linkedin },
  { label: "Résumé", href: site.links.resume },
];
---

<Base>
  <main id="main" class="mx-auto max-w-2xl px-6 pb-24">
    <header class="pt-20 text-center sm:pt-28">
      <Avatar />

      <h1 class="text-name mt-7">{site.name}</h1>

      <p class="text-ink-muted mt-2 text-[0.9375rem]">
        {site.role} · {site.location}
      </p>

      <p class="text-ink-secondary mx-auto mt-6 max-w-[38ch] text-pretty">
        {site.hero.statement}
      </p>

      <nav
        class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2"
        aria-label="Contact"
      >
        {
          contactLinks.map((link) => (
            <a href={link.href} class="link-underline py-1 text-[0.9375rem]">
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>

    <Section id="about" label="About">
      <div class="prose-simple">
        {site.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </Section>

    <Section id="experience" label="Experience">
      <ol class="space-y-7">
        {
          site.experience.map((role) => (
            <li data-role>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <p class="font-medium">
                  {role.title},{" "}
                  <span class="text-ink-secondary font-normal">{role.company}</span>
                </p>
                <p class="text-ink-muted text-[0.8125rem] tabular-nums">{role.period}</p>
              </div>
              <p
                data-role-summary
                class="text-ink-secondary mt-1.5 text-[0.9375rem] leading-relaxed"
              >
                {role.summary}
              </p>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section id="projects" label="Projects">
      <ul class="space-y-2">
        {
          work.map((entry) => {
            const icon = iconFor(entry.data.icon);
            return (
              <li>
                <a
                  data-work-item
                  href={`/work/${entry.id}/`}
                  class="hover:bg-surface -mx-3 flex items-center gap-4 rounded-xl px-3 py-3 transition-colors"
                >
                  {icon && (
                    <Image
                      src={icon}
                      alt=""
                      width={96}
                      height={96}
                      loading="lazy"
                      class="app-icon size-11 shrink-0"
                    />
                  )}
                  <span class="min-w-0 flex-1">
                    <span class="block font-medium">{entry.data.title}</span>
                    <span class="text-ink-secondary block text-[0.9375rem] leading-snug">
                      {entry.data.tagline}
                    </span>
                  </span>
                  <span class="text-ink-muted shrink-0 text-[1.1rem]" aria-hidden="true">
                    ›
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </Section>

    {
      posts.length > 0 && (
        <Section id="writing" label="Writing">
          <ul class="space-y-2">
            {posts.map((post) => (
              <li>
                <a
                  href={`/writing/${post.id}/`}
                  class="hover:bg-surface -mx-3 block rounded-xl px-3 py-3 transition-colors"
                >
                  <span class="block font-medium">{post.data.title}</span>
                  <span class="text-ink-secondary block text-[0.9375rem] leading-snug">
                    {post.data.description}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    <Section id="education" label="Education">
      <dl class="space-y-4">
        {
          site.education.map((entry) => (
            <div>
              <dt class="font-medium">{entry.school}</dt>
              <dd class="text-ink-secondary mt-0.5 text-[0.9375rem]">{entry.detail}</dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <Section id="toolkit" label="Toolkit">
      <dl class="space-y-3">
        {
          site.skills.map((group) => (
            <div class="sm:flex sm:gap-6">
              <dt class="text-ink-muted text-[0.875rem] sm:w-28 sm:shrink-0">{group.label}</dt>
              <dd class="text-ink-secondary text-[0.9375rem]">{group.items}</dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <footer class="border-hairline text-ink-muted mt-20 border-t pt-8 text-center text-[0.875rem]">
      <p>{site.name} · {site.location}</p>
    </footer>
  </main>
</Base>
