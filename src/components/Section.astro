---
interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<section id={id} class="mt-16">
  <h2 class="text-ink-muted mb-5 text-[0.8125rem] font-medium tracking-[0.14em] uppercase">
    {label}
  </h2>
  <slot />
</section>

<style>
  /* Section labels are the one place the sans face is used at heading level;
     the serif reads as a title and these are signposts. */
  h2 {
    font-family: var(--font-sans);
    letter-spacing: 0.14em;
  }
</style>
