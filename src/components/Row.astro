---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  index: number;
  title: string;
  subtitle?: string;
  meta?: string;
  metaSecondary?: string;
  href?: string;
  icon?: ImageMetadata;
  iconAlt?: string;
}

const { index, title, subtitle, meta, metaSecondary, href, icon, iconAlt } =
  Astro.props;

const num = String(index).padStart(2, "0");
const Tag = href ? "a" : "div";

/* Grid placement is spelled out per cell rather than left to auto-placement.
   Narrow screens stack into one column beside the number; from `sm` up
   everything sits on a single row. */
const cells = icon
  ? {
      grid: "grid-cols-[2.25rem_1fr] sm:grid-cols-[2.25rem_auto_1fr_auto]",
      text: "col-start-2 row-start-2 sm:col-start-3 sm:row-start-1",
      meta: "col-start-2 row-start-3 sm:col-start-4 sm:row-start-1",
    }
  : {
      grid: "grid-cols-[2.25rem_1fr] sm:grid-cols-[2.25rem_1fr_auto]",
      text: "col-start-2 row-start-1",
      meta: "col-start-2 row-start-2 sm:col-start-3 sm:row-start-1",
    };
---

<li class="border-t border-hairline last:border-b">
  <Tag
    {...href ? { href } : {}}
    class:list={[
      "group grid items-start gap-x-4 gap-y-3 py-7 sm:gap-x-6",
      cells.grid,
      href &&
        "-mx-4 px-4 transition-colors duration-200 hover:bg-surface focus-visible:bg-surface sm:-mx-6 sm:px-6",
    ]}
  >
    <span
      class="col-start-1 row-start-1 pt-1.5 font-mono text-meta text-ink-muted transition-colors duration-200 group-hover:text-accent"
      aria-hidden="true">{num}</span
    >

    {
      icon && (
        <Image
          src={icon}
          alt={iconAlt ?? ""}
          width={128}
          height={128}
          loading="lazy"
          decoding="async"
          class="app-icon col-start-2 row-start-1 size-14 sm:size-16"
        />
      )
    }

    <span class={cells.text}>
      <span
        class="font-display text-row block transition-colors duration-200 group-hover:text-accent"
        >{title}</span
      >
      {
        subtitle && (
          <span class="text-ink-secondary mt-1.5 block text-[0.9375rem] leading-relaxed">
            {subtitle}
          </span>
        )
      }
      <slot />
    </span>

    {
      (meta || metaSecondary) && (
        <span
          class:list={[
            "flex gap-x-3 font-mono text-meta text-ink-muted sm:flex-col sm:items-end sm:gap-y-1 sm:pt-1.5 sm:text-right",
            cells.meta,
          ]}
        >
          {meta && <span>{meta}</span>}
          {metaSecondary && <span>{metaSecondary}</span>}
        </span>
      )
    }
  </Tag>
</li>
