---
/* Rendered fixed to the top-right corner so it never joins the centred column
   and never becomes something else to read. */
---

<button
  type="button"
  data-theme-toggle
  class="border-hairline bg-surface text-ink-muted hover:text-ink fixed top-3 right-3 z-40 grid size-11 place-items-center rounded-full border transition-colors sm:top-5 sm:right-5"
  aria-label="Switch to dark theme"
  aria-pressed="false"
>
  <svg
    class="size-[1.15rem]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <g data-icon-sun>
      <circle cx="12" cy="12" r="4.2"></circle>
      <path
        d="M12 2.6v2.1M12 19.3v2.1M21.4 12h-2.1M4.7 12H2.6M18.6 5.4l-1.5 1.5M6.9 17.1l-1.5 1.5M18.6 18.6l-1.5-1.5M6.9 6.9L5.4 5.4"
      ></path>
    </g>
    <path data-icon-moon d="M20.2 14.2A8.4 8.4 0 1 1 9.8 3.8a6.6 6.6 0 0 0 10.4 10.4Z"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const button = document.querySelector("[data-theme-toggle]");
    if (!button) return;

    const sun = button.querySelector("[data-icon-sun]");
    const moon = button.querySelector("[data-icon-moon]");

    const paint = (theme) => {
      const dark = theme === "dark";
      // Show the icon for the theme you would switch *to*.
      sun.style.display = dark ? "" : "none";
      moon.style.display = dark ? "none" : "";
      button.setAttribute("aria-pressed", String(dark));
      button.setAttribute(
        "aria-label",
        dark ? "Switch to light theme" : "Switch to dark theme",
      );
    };

    paint(document.documentElement.dataset.theme);

    button.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      document.documentElement.style.colorScheme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Storage can be blocked; the toggle should still work for this visit.
      }
      paint(next);
    });
  })();
</script>
